# Copy to e2e/.env (never committed) and fill in.

# Target. Defaults to the deployed app and API.
E2E_BASE_URL=https://icy-flower-092597810.7.azurestaticapps.net
E2E_API_URL=https://sigloc-api-hbfzcfd6ghephmcc.northcentralus-01.azurewebsites.net

# Demo accounts the suite logs in with. They must be partners (the carrier bids on the
# contractor's auctions).
E2E_CONTRACTOR_EMAIL=
E2E_CONTRACTOR_PASSWORD=
E2E_CARRIER_EMAIL=
E2E_CARRIER_PASSWORD=

# Catalogue product (dry, palletized, not dangerous/fragile) used to build segments.
E2E_PRODUCT_SKU=PAR-001
# Carrier vehicle that bids: free, "Baú / Sider" body. Set HAS_TRACKER=true if it has a Traccar device.
E2E_BID_PLATE=ABC1D23
E2E_BID_PLATE_HAS_TRACKER=false

# "chrome" uses the installed Google Chrome. Leave empty to use Playwright's Chromium
# (then run `npx playwright install chromium` once).
E2E_BROWSER_CHANNEL=chrome
