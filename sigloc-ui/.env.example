# Base URL of the Sigloc API (no trailing slash).
# Defaults to the hosted Azure instance when omitted.
VITE_API_BASE_URL=https://sigloc-api-hbfzcfd6ghephmcc.northcentralus-01.azurewebsites.net

# Google OAuth 2.0 Client ID used to generate the idToken for Google sign-in.
# Leave empty to disable Google authentication buttons.
VITE_GOOGLE_CLIENT_ID=

# Optional map tile provider for the driver location map (Leaflet URL template and attribution HTML).
# Defaults to Esri's keyless World Street Map; set both to use a keyed provider such as MapTiler or Stadia.
# Do not point this at tile.openstreetmap.org (blocked for apps) or CARTO raster tiles (API key required).
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=
